# PocketOps configuration — copy to `.env` and fill in. NEVER commit the real .env.
# These are placeholders only.

# Nebius Token Factory API key (create one at https://tokenfactory.nebius.com -> API keys).
# Stays on the server. Never sent to the browser.
NEBIUS_API_KEY=your-token-factory-api-key

# NVIDIA open model served by Token Factory. Model IDs are region-scoped, so verify the exact
# ID in your Token Factory catalog (or use the "Check model availability" button in the app,
# which lists /models). Nebius documents this ID for the us-central1 endpoint:
NEBIUS_MODEL=nvidia/nemotron-3-super-120b-a12b

# OpenAI-compatible base URL for the SAME region as the model above.
#   us-central1: https://api.tokenfactory.us-central1.nebius.com/v1
#   eu-north1:   https://api.tokenfactory.nebius.com/v1
NEBIUS_BASE_URL=https://api.tokenfactory.us-central1.nebius.com/v1

# Optional tuning
# NEBIUS_MAX_TOKENS=1500
# NEBIUS_TEMPERATURE=0.3
# NEBIUS_TIMEOUT_MS=60000

# Server (defaults shown). HOST=127.0.0.1 keeps the app reachable only from this machine.
# PORT=3000
# HOST=127.0.0.1
# Where memory/notes are stored (plain JSON, NOT encrypted):
# POCKETOPS_DATA_FILE=./data/store.json
